# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://eihrsnqqpaafjzhgwxch.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy fallback only. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for new Supabase projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPECTED_PROD_SUPABASE_REF=eihrsnqqpaafjzhgwxch
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
SUPABASE_SECRET_KEY=your-supabase-secret-key-never-expose-to-browser
SUPABASE_SERVICE_ROLE_KEY=your-legacy-supabase-service-role-key-fallback

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Google / Gemini AI API Settings
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_GENERATIVE_AI_API_KEY=your-google-generative-ai-api-key

# Gemini Operation Models (Model Registry mappings)
GEMINI_MODEL_CHAT=gemini-3.6-flash
GEMINI_MODEL_FAST=gemini-3.6-flash
GEMINI_MODEL_NOTES=gemini-3.6-flash
GEMINI_MODEL_QUIZ=gemini-3.6-flash

# Other Providers (If needed)
# Reviewer Maker uses Claude Sonnet 5. Prefer numbered keys for legitimate
# provider redundancy. Slots 1-3 are primary; slots 4-5 are secondary/backup.
ANTHROPIC_API_KEY_1=your-primary-anthropic-api-key
ANTHROPIC_API_KEY_2=your-primary-anthropic-api-key
ANTHROPIC_API_KEY_3=your-primary-anthropic-api-key
ANTHROPIC_API_KEY_4=your-secondary-anthropic-api-key
ANTHROPIC_API_KEY_5=your-secondary-anthropic-api-key
REVIEWER_AI_PROVIDER=anthropic
REVIEWER_AI_MODEL=claude-sonnet-5
OPENAI_API_KEY=your-openai-api-key

# UI Access password
PREMIUM_PASSWORD=your-premium-password

# ──────────────────────────────────────────────────────────────
# CAPTCHA (Phase 6.3)
#
# AUTH_CAPTCHA_UI_ENABLED controls whether RecallMate renders
# the Turnstile widget in authentication forms.
#
# IMPORTANT: This is independent of whether Supabase enforces
# CAPTCHA on the server side. Both must be configured to agree:
#   - Application: AUTH_CAPTCHA_UI_ENABLED=true + site key
#   - Supabase: Dashboard → Auth → Bot and Abuse Protection
#
# Leave false in local development unless testing CAPTCHA flows.
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_AUTH_CAPTCHA_UI_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY is server-side only — never prefix with NEXT_PUBLIC_
TURNSTILE_SECRET_KEY=
