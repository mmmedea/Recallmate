# App URL and scheduled worker authentication
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=your-long-random-cron-secret

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-browser

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Google / Gemini AI API Settings
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_GENERATIVE_AI_API_KEY=your-google-generative-ai-api-key

# Gemini Operation Models (Model Registry mappings)
GEMINI_MODEL_CHAT=gemini-3.6-flash
GEMINI_MODEL_FAST=gemini-3.6-flash
GEMINI_MODEL_NOTES=gemini-3.6-flash
GEMINI_MODEL_QUIZ=gemini-3.6-flash

# Provider routing (optional; defaults to Google)
AI_PROVIDER_FAST=google
AI_PROVIDER_NOTES=google
AI_PROVIDER_QUIZ=google
AI_PROVIDER_CHAT=google
AI_PROVIDER_REVIEWER=google

# DeepSeek (optional alternative provider)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# Other Providers (If needed)
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# UI Access password
PREMIUM_PASSWORD=your-premium-password

# ──────────────────────────────────────────────────────────────
# CAPTCHA (Phase 6.3)
#
# AUTH_CAPTCHA_UI_ENABLED controls whether RecallMate renders
# the Turnstile widget in authentication forms.
#
# IMPORTANT: This is independent of whether Supabase enforces
# CAPTCHA on the server side. Both must be configured to agree:
#   - Application: AUTH_CAPTCHA_UI_ENABLED=true + site key
#   - Supabase: Dashboard → Auth → Bot and Abuse Protection
#
# Leave false in local development unless testing CAPTCHA flows.
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_AUTH_CAPTCHA_UI_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY is server-side only — never prefix with NEXT_PUBLIC_
TURNSTILE_SECRET_KEY=
