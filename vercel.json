{
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://generativelanguage.googleapis.com https://api.assemblyai.com;"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/tutor",
      "destination": "https://recallmate.vercel.app/"
    },
    {
      "source": "/tutor/:path*",
      "destination": "https://recallmate.vercel.app/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/old-study-tool/:path*",
      "destination": "https://recallmate.vercel.app/:path*",
      "permanent": true
    }
  ]
}
